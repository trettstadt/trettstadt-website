# Caddy runs with network_mode: host (docker-compose.yml) so that it sees the real IPv4 and IPv6
# client address. It cannot resolve Docker service names: the apps served from this server are
# published on 127.0.0.1 only (astro-site 18080, umami 18081, calcom 18082, jitsi-web 18083).
trettstadt.de {
    reverse_proxy 127.0.0.1:18080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

analytics.trettstadt.de {
    reverse_proxy 127.0.0.1:18081

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

book.trettstadt.de {
    reverse_proxy 127.0.0.1:18082

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'self' https://trettstadt.de http://localhost:*"
        Access-Control-Allow-Origin "https://trettstadt.de"
    }
}

meet.trettstadt.de {
    reverse_proxy 127.0.0.1:18083

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

expense-splitter.trettstadt.de {
    reverse_proxy http://10.100.0.2:8082 {
        # Pass only Caddy's resolved client address, not a client-supplied XFF chain.
        header_up X-Forwarded-For {client_ip}
    }
}

secret-santa.trettstadt.de {
    reverse_proxy http://10.100.0.2:8083 {
        # Pass only Caddy's resolved client address, not a client-supplied XFF chain.
        header_up X-Forwarded-For {client_ip}
    }
}

einkauf.trettstadt.de {
    reverse_proxy http://10.100.0.2:8084 {
        # Pass only Caddy's resolved client address, not a client-supplied XFF chain.
        header_up X-Forwarded-For {client_ip}
    }
}

# The Authelia login that einkauf.trettstadt.de (and the other protected apps) redirect to.
auth.trettstadt.de {
    reverse_proxy http://10.100.0.2:8085 {
        # Pass only Caddy's resolved client address, not a client-supplied XFF chain.
        header_up X-Forwarded-For {client_ip}
    }
}
