---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <h1 class="animate font-semibold text-2xl text-black dark:text-white">
              Geschäftskritische Kernsysteme modernisieren – ohne Ausfallzeiten und ohne Big-Bang-Risiko.
            </h1>
            <p class="animate">
              Als selbstständiger <strong>Senior Software Architect & Lead Developer</strong> unterstütze ich Banken, Zahlungsdienstleister und regulierte Enterprise-Kunden dabei, monolithische Mainframe- und Legacy-Systeme in hochverfügbare, audit-konforme <strong>Spring-Boot- und Kubernetes-Architekturen</strong> zu überführen.
            </p>
            <p class="animate">
              <strong>Strategy meets Code:</strong> Keine reinen Folienkonzepte, sondern lauffähiger Code und praxiserprobte Bereitstellung – von der schrittweisen Migration im laufenden Betrieb über robuste Java 21 / Spring-Boot-Services bis hin zu standardisierten Helm-Charts für zentrale Plattformteams. Praxiserprobt im hochregulierten Landesbanken-Umfeld (BaFin, DORA, ISO 20022).
            </p>
            <p class="animate">
              Planen Sie eine Modernisierung oder suchen Sie einen Sparringpartner für Ihre Architektur? In einem unverbindlichen 30-minütigen Fachgespräch klären wir Machbarkeit, Risiken und konkrete nächste Schritte.
            </p>
            <p class="animate pt-2">
              <Link href="/termin" underline={false} reload>
                <span class="inline-block px-4 py-2 rounded border border-black/15 dark:border-white/30 hover:border-black/25 hover:dark:border-white/50 transition-colors duration-300 ease-in-out font-medium">
                  30 Min. Fachgespräch vereinbaren &rarr;
                </span>
              </Link>
            </p>
            <div class="animate pt-4">
              <pre class="mermaid">
flowchart LR
    Clients["Banking-Clients &amp; Web-Frontends"]
    
    Gateway["API Gateway &amp; Routing<br/><i>(Request-Verteilung)</i>"]
    
    subgraph Legacy ["Altsysteme (Paralleler Rückbau)"]
        direction TB
        Host["Mainframe (COBOL/DB2)"]
        WAS["WebSphere / Monolithen"]
    end

    subgraph Modern ["Zielarchitektur (Kubernetes)"]
        direction TB
        Services["Spring Boot Services<br/><i>(Modul für Modul)</i>"]
        Helm["Helm-Charts &amp; GitOps"]
        Services --> Helm
    end

    Clients --> Gateway
    Gateway -->|"Bestand"| Legacy
    Gateway -->|"Migriert"| Modern
    Modern <-.->|"Datenbrücke"| Legacy
              </pre>
            </div>
          </article>
        </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Fachartikel & Insights
          </h5>
          <Link href="/blog">
            Alle Beiträge
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Berufserfahrung & Referenzen
          </h5>
          <Link href="/work">
            Vollständige Übersicht
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Blueprints & Projekte
          </h5>
          <Link href="/projects">
            Alle Projekte
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Kontakt & Sparringpartner
        </h5>
        <article>
          <p>
            Sie möchten ein konkretes Vorhaben besprechen, Legacy-Workloads migrieren oder Architektur-Standards etablieren? Buchen Sie direkt ein 30-minütiges Fachgespräch oder schreiben Sie mir eine Nachricht.
          </p>
          <p class="mt-4">
            <Link href="/termin" underline={false} reload>
              <span class="inline-block px-4 py-2 rounded border border-black/15 dark:border-white/30 hover:border-black/25 hover:dark:border-white/50 transition-colors duration-300 ease-in-out font-medium">
                Termin buchen
              </span>
            </Link>
          </p>
        </article>
        <article>
          <p>
            Sie erreichen mich auch auf LinkedIn, XING oder direkt per E-Mail.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
